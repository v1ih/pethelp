# ---- Desenvolvimento local (PostgreSQL na sua máquina) ----
PORT=3333
CORS_ORIGIN=http://localhost:5173
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coloque_a_sua_senha
POSTGRES_DATABASE=pethelp
POSTGRES_ADMIN_DATABASE=postgres
JWT_SECRET=troque-esta-chave-antes-de-publicar

# ---- Produção / nuvem (Render, Neon, Supabase) ----
# Quando DATABASE_URL está definida, ela tem prioridade sobre as variáveis POSTGRES_* acima
# e o SSL é ativado automaticamente.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# POSTGRES_SSL=true
# Domínios do site publicado que podem acessar a API (separados por vírgula).
# Ex.: CORS_ORIGINS=https://pethelp-web.onrender.com
# CORS_ORIGINS=
